# ============================================================
# KoraPay — Variables de entorno
# Copiar a .env y completar valores antes de ejecutar
# ============================================================

NODE_ENV=development

# PostgreSQL (local Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/korapay_dev
DIRECT_URL=postgresql://postgres:postgres@localhost:5435/korapay_dev

# API
API_PORT=3061
CORS_ORIGINS=http://localhost:3060

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3061/api/v1

# Demo mode (autenticacion local, sin proveedor externo)
DEMO_MODE=true
DEMO_USER_EMAIL=demo@korapay.local
DEMO_USER_PASSWORD=KoraPay123!

# Decolecta (tipo de cambio SUNAT, DNI/RUC)
DECOLECTA_API_KEY=REEMPLAZAR
DECOLECTA_API_URL=https://api.decolecta.com

# Logging
LOG_LEVEL=debug

# Seed (requeridas por prisma/seed.ts)
DEMO_USER_AUTH_ID=demo-user-id
DEMO_USER_NAME=Nombre Apellido
SEED_USD_TO_PEN=3.75
SEED_EXCHANGE_DATE=2026-01-01

# Limites y tiempos (antes hardcodeados)
MAX_FILE_SIZE=10485760
INGESTION_TOKEN_PREFIX=kp_ing_
DECOLECTA_TIMEOUT_MS=10000
PUBLIC_URL=http://localhost:3061
