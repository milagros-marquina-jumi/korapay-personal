{
	"name": "@korapay/api",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "nest start --watch",
		"build": "nest build",
		"start": "node dist/main.js",
		"lint": "biome check .",
		"fix": "biome check --write --unsafe . && biome format --write .",
		"typecheck": "tsc --noEmit",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"db:generate": "prisma generate --schema=../../prisma/schema.prisma",
		"db:push": "prisma db push --schema=../../prisma/schema.prisma",
		"db:migrate": "prisma migrate dev --schema=../../prisma/schema.prisma",
		"db:seed": "tsx ../../prisma/seed.ts",
		"email:ingest:fixture": "tsx scripts/ingest-fixture.ts",
		"db:studio": "prisma studio --schema=../../prisma/schema.prisma",
		"openapi": "tsx scripts/generate-openapi.ts"
	},
	"dependencies": {
		"@fastify/compress": "catalog:",
		"@fastify/cors": "catalog:",
		"@fastify/helmet": "catalog:",
		"@fastify/multipart": "catalog:",
		"@fastify/rate-limit": "catalog:",
		"@fastify/static": "catalog:",
		"@korapay/domain": "workspace:*",
		"@nestjs/common": "catalog:",
		"@nestjs/config": "catalog:",
		"@nestjs/core": "catalog:",
		"@nestjs/platform-fastify": "catalog:",
		"@nestjs/schedule": "^6.1.3",
		"@nestjs/swagger": "catalog:",
		"@nestjs/throttler": "catalog:",
		"@prisma/client": "catalog:",
		"class-transformer": "catalog:",
		"class-validator": "catalog:",
		"cookie-parser": "catalog:",
		"decimal.js": "catalog:",
		"pino": "catalog:",
		"pino-pretty": "catalog:",
		"reflect-metadata": "catalog:",
		"rxjs": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.13",
		"@korapay/typescript-config": "workspace:*",
		"@nestjs/cli": "^11.0.0",
		"@nestjs/testing": "^11.0.0",
		"@types/jest": "catalog:",
		"@types/node": "catalog:",
		"jest": "catalog:",
		"prisma": "catalog:",
		"ts-jest": "catalog:",
		"tsx": "^4.19.0",
		"typescript": "catalog:"
	}
}
