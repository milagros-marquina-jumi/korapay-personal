{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./base.json",
	"compilerOptions": {
		"target": "ES2017",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"incremental": true,
		"plugins": [{ "name": "next" }],
		"paths": {
			"@/*": ["./src/*"],
			"@korapay/ui/*": ["../../packages/ui/src/*"],
			"@korapay/domain": ["../../packages/domain/src/index.ts"],
			"@korapay/api-client": ["../../packages/api-client/src/index.ts"]
		}
	}
}
