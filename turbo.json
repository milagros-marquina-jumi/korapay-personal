{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["**/.env.*local"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "dist/**", "!.next/cache/**"]
		},
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"test": {
			"dependsOn": ["^build"],
			"inputs": [
				"src/**",
				"test/**",
				"tests/**",
				"vitest.config.*",
				"jest.config.*"
			]
		},
		"fix": {
			"cache": false
		},
		"openapi": {
			"cache": false,
			"outputs": ["openapi.json"]
		},
		"generate": {
			"cache": false,
			"dependsOn": ["openapi"],
			"outputs": ["src/**"]
		},
		"db:generate": {
			"cache": false
		},
		"db:migrate": {
			"cache": false
		},
		"db:migrate:deploy": {
			"cache": false
		},
		"db:reset": {
			"cache": false
		},
		"db:seed": {
			"cache": false
		}
	}
}
